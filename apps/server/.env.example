# ---- Runtime ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting & audit logs)
TRUST_PROXY=false

# ---- API documentation ----
# Swagger UI at /docs. Defaults to false when NODE_ENV=production.
SWAGGER_ENABLED=true

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public

# ---- JWT secrets (generate with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-openssl-rand-base64-48
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-must-differ-from-access
# Token lifetimes in seconds
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- Cookies ----
# Optional. Leave empty to scope cookies to the API host.
COOKIE_DOMAIN=

# ---- Emails ----
APP_URL=http://localhost:5173
MAIL_FROM="Auth Service <[EMAIL_ADDRESS]>"
BCC_BUSINESS_EMAIL=
# BCC every transactional email to business inbox (optional). Leave empty to disable.
# Example: BCC_BUSINESS_EMAIL="founder@company.com"
# Resend API key (https://resend.com -> API Keys). Leave empty to log emails only.
RESEND_API_KEY=

# ---- Security limits ----
RATE_LIMIT_GLOBAL_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15


# ---- Cloudflare Turnstile ----
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=0x4AAAAAAErSKf2guxHZYgKD6X5IzluMPLY
TURNSTILE_SITE_KEY=0x4AAAAAAErSKWTHBHnTxS7o

# ---- Seed (local dev only, `pnpm db:seed`) ----
# Creates the initial verified user. SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD
# are accepted as aliases. Not read at app boot, only by the seed script.
SEED_USER_EMAIL=user@example.com
# Min 12 chars with upper/lower/digit/special. Leave empty unless seeding.
SEED_USER_PASSWORD=